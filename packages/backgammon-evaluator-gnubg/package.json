{
  "name": "@backgammon-trainer/backgammon-evaluator-gnubg",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./src/node.ts",
      "import": "./dist/node.js"
    },
    "./testing": {
      "types": "./src/testing.ts",
      "import": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test --ext .ts",
    "test": "vitest run",
    "smoke": "pnpm build && node dist/smoke.js"
  },
  "dependencies": {
    "@backgammon-trainer/backgammon-analysis": "workspace:*",
    "@backgammon-trainer/backgammon-engine": "workspace:*"
  }
}
