# Local setup: copy this file to .env.local at repository root and edit values there.
# This committed file is the supported variable inventory and contains placeholders only.

# Browser-public variables (VITE_* is bundled into browser code)
# VITE_COACH_MODEL_MODE: fixture | server | none
VITE_COACH_MODEL_MODE=fixture
VITE_API_BASE_URL=http://localhost:3001

# Optional development-only browser fixture evaluator toggle
VITE_ENABLE_FIXTURE_EVALUATOR=false

# Server runtime host/port
SERVER_HOST=0.0.0.0
SERVER_PORT=3001

# Server evaluator provider mode: none | mock
EVALUATOR_PROVIDER=none

# Server coach provider mode: none | mock | openai-compatible
MODEL_PROVIDER=mock

# Server-only OpenAI-compatible provider settings
OPENAI_COMPAT_BASE_URL=https://api.openai.com/v1
OPENAI_COMPAT_MODEL=replace-with-model-id
OPENAI_COMPAT_API_KEY=replace-with-real-key-for-local-use
OPENAI_COMPAT_TIMEOUT_MS=15000
OPENAI_COMPAT_PROVIDER_LABEL=openai-compatible
